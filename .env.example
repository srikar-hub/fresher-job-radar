# Python runtime configuration. Never put real credentials in this file.
APP_ENV=development
LOG_LEVEL=INFO
JOB_PROFILE_FILE=config/job_profile.json

# AI is optional and must remain disabled unless explicitly configured.
AI_ENABLED=false
AI_MAX_REQUESTS_PER_SCAN=3
AI_TIMEOUT_SECONDS=8
AI_MAX_INPUT_CHARS=6000

# For local Telegram development only, set these in the ignored .env file:
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=

# Telegram Bot API notifications (local only; never commit real values)
BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Local Cloudflare Worker API (use the same secret in worker/.dev.vars).
SCANNER_API_BASE_URL=http://127.0.0.1:8787
SCANNER_API_SECRET=
